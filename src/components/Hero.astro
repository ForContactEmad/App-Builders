---
import { stats } from "../data/tasks.js";
---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white transition-colors dark:from-gray-900 dark:to-gray-950">
  <div class="container-page py-20 text-center md:py-28">
    <span class="inline-flex items-center rounded-full border border-brand-200 bg-white px-4 py-1.5 text-xs font-medium text-brand-700 dark:border-brand-800 dark:bg-gray-900 dark:text-brand-400">
      منصة تنفيذ بمساعدة الذكاء الاصطناعي
    </span>

    <h1 class="mt-6 text-4xl font-bold leading-tight text-gray-900 md:text-6xl dark:text-white">
      طوّر تطبيقك.
      <br />
      <span class="text-brand-600 dark:text-brand-400">من الفكرة إلى النشر.</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-600 md:text-xl dark:text-gray-400">
      {stats.total} مهمة عملية تبني فيها تطبيقك خطوة بخطوة، من تحديد الفكرة وتصميم الواجهة
      إلى الاختبار والتجهيز للنشر.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="#pricing" class="btn-primary w-full sm:w-auto">اشترك وابدأ الآن</a>
      <a href="#tasks" class="btn-secondary w-full sm:w-auto">شوف المهام</a>
    </div>

    <div class="mt-14 flex items-center justify-center gap-8 text-sm text-gray-500 dark:text-gray-400">
      <div>
        <strong class="text-2xl font-bold text-brand-600 dark:text-brand-400">{stats.total}</strong><br />مهمة
      </div>
      <div class="h-10 w-px bg-gray-200 dark:bg-gray-700"></div>
      <div>
        <strong class="text-2xl font-bold text-brand-600 dark:text-brand-400">{stats.stages}</strong><br />مراحل
      </div>
      <div class="h-10 w-px bg-gray-200 dark:bg-gray-700"></div>
      <div>
        <strong class="text-2xl font-bold text-brand-600 dark:text-brand-400">7</strong><br />أيام ضمان
      </div>
    </div>
  </div>
</section>